      <aliases enabled='yes' />
      <column caption='Host_Since' datatype='date' name='[Calculation_20442990629056512]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='updated_neighbourhood' datatype='string' name='[Calculation_20442990631010305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Neighbourhood],&quot;Unknown&quot;)' />
      </column>
      <column caption='Review Score Rating(bin)' datatype='string' name='[Calculation_20442990631292930]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]),&quot;Not Rated&quot;)' />
      </column>
      <column caption='Updated_beds' datatype='integer' name='[Calculation_20442990632062979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Beds],0)' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_20442990636437512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 20442990635704327]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column caption='Room Category' datatype='string' name='[Room Type (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Room Type]' new-bin='true'>
          <bin default-name='false' value='&quot;Budget Stay&quot;'>
            <value>&quot;Private room&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Premium Stay&quot;'>
            <value>&quot;Entire home/apt&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Shared Accomedation&quot;'>
            <value>&quot;Shared room&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Room Type]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
